# docker compose 环境变量示例
# 复制为 .env 后按需修改

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
REDIS_PORT=6379

# Nacos认证。每个环境生成独立值，不要提交docker/.env。
# NACOS_USERNAME/NACOS_PASSWORD必须匹配已修改默认nacos/nacos密码的Nacos用户。
NACOS_USERNAME=change-me
NACOS_PASSWORD=change-me
NACOS_AUTH_IDENTITY_KEY=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me
NACOS_AUTH_TOKEN=change-to-a-random-base64-key-at-least-32-bytes
